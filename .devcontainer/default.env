#SYSTEM

# POSTGRESQL

POSTGRES_DB=postgres
POSTGRES_PASSWORD=odoo
POSTGRES_USER=odoo

# ODOO

# CUSTOM

ENTERPRISE_ADDONS=../../odoo_src/enterprise_addons
THEME_ADDONS=../../odoo_src/theme_addons

CUSTOM_ADDONS=../addons

OCA_ADDONS=../../OCA/addons
OPEN_UPGRADE=../../OCA/OpenUpgrade

OPENUPGRADE_TARGET_VERSION=17.0

ENTRYPOINT=python3 -m debugpy --listen localhost:5678 /usr/bin/odoo -c /etc/odoo/odoo.conf
#ENTRYPOINT=/usr/bin/odoo -d upgrade -c /etc/odoo/odoo.conf -upgrade-path=/var/lib/odoo/OpenUpgrade/openupgrade_scripts/scripts --update all --stop-after-init --load=base,web,mail,openupgrade_framework