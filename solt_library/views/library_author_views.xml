<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="library_author_tree" model="ir.ui.view">
        <field name="name">library.author.tree</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <tree>
                <header>
                <button name="get_popular_authors"
                        string="Ver Autores Populares"
                        type="object"
                        class="btn-success"/>
            </header>
                <field name="name"/>
                <field name="nationality"/>
                <field name="book_count"/>
            </tree>
        </field>
    </record>

    <record id="library_author_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Author Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="nationality"/>
                            <field name="birth_date"/>
                            <field name="death_date"/>
                        </group>
                        <group>
                            <field name="age"/>
                            <field name="website" widget="url"/>
                            <field name="book_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Biography">
                            <field name="biography"/>
                        </page>
                        <page string="Books">
                            <field name="book_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="isbn"/>
                                    <field name="category_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'available'"
                                           decoration-warning="state == 'low_stock'"
                                           decoration-danger="state == 'unavailable'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="library_author_kanban" model="ir.ui.view">
        <field name="name">library.author.kanban</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="image_128"/>
                <field name="nationality"/>
                <field name="book_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('library.author', 'image_128', record.id.raw_value)"
                                     alt="Avatar" class="o_image_64_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="nationality"/></div>
                                <div><field name="book_count"/> books</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="library_author_action" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>