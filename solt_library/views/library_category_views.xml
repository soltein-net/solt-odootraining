<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="library_category_tree" model="ir.ui.view">
        <field name="name">library.category.tree</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="complete_name"/>
                <field name="book_count"/>
            </tree>
        </field>
    </record>

    <record id="library_category_form" model="ir.ui.view">
        <field name="name">library.category.form</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="book_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subcategories" invisible="not child_ids">
                            <field name="child_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="book_count"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">library.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>