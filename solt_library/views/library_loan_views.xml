<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="library_loan_tree" model="ir.ui.view">
        <field name="name">library.loan.tree</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'loaned' and days_overdue > 0"
                  decoration-muted="state in ['returned', 'cancelled']">
                <field name="reference"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="loan_date"/>
                <field name="expected_return_date"/>
                <field name="actual_return_date"/>
                <field name="days_overdue"/>
                <field name="late_fee" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'loaned'"
                       decoration-muted="state == 'returned'"
                       decoration-danger="state in ['lost', 'cancelled']"/>
            </tree>
        </field>
    </record>

    <record id="library_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm Loan" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_return" type="object"
                            string="Register Return" class="btn-success"
                            invisible="state != 'loaned'"/>
                    <button name="action_mark_lost" type="object"
                            string="Mark as Lost" class="btn-danger"
                            invisible="state != 'loaned'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state != 'draft'"/>
                    <button name="print_report_by_reference_xlsx" type="object"
                            string="Report by Button(EXCEL)"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,loaned,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Loan">
                            <field name="member_id"
                                   readonly="state != 'draft'"/>
                            <field name="book_id"
                                   readonly="state != 'draft'"/>
                            <field name="book_isbn" readonly="1"/>
                            <field name="book_authors" readonly="1"/>
                        </group>
                        <group string="Dates">
                            <field name="loan_date"
                                   readonly="state != 'draft'"/>
                            <field name="expected_return_date"/>
                             <field name="days_remaining"
                   decoration-danger="days_remaining &lt; 0"
                   decoration-warning="days_remaining &lt;= 3 and days_remaining &gt;= 0"/>
                            <field name="actual_return_date"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group invisible="state == 'draft'">
                        <group string="Late Fee">
                            <field name="days_overdue"/>
                            <field name="late_fee"/>
                            <field name="fee_paid"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="library_loan_calendar" model="ir.ui.view">
        <field name="name">library.loan.calendar</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <calendar string="Returns" date_start="expected_return_date"
                      color="member_id" mode="month">
                <field name="book_id"/>
                <field name="member_id"/>
            </calendar>
        </field>
    </record>

    <record id="library_loan_search" model="ir.ui.view">
        <field name="name">library.loan.search</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <separator/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="loaned" string="Loaned"
                        domain="[('state', '=', 'loaned')]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('state', '=', 'loaned'), ('days_overdue', '>', 0)]"/>
                <filter name="returned" string="Returned"
                        domain="[('state', '=', 'returned')]"/>
                <separator/>
                <filter name="due_today" string="Due Today"
                        domain="[('expected_return_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_member" string="Member"
                            context="{'group_by': 'member_id'}"/>
                    <filter name="group_book" string="Book"
                            context="{'group_by': 'book_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Loan Date"
                            context="{'group_by': 'loan_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_loan_action" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="search_view_id" ref="library_loan_search"/>
        <field name="context">{'search_default_loaned': 1}</field>
    </record>

    <record id="library_loan_overdue_action" model="ir.actions.act_window">
        <field name="name">Overdue Loans</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'loaned'), ('days_overdue', '>', 0)]</field>
    </record>
</odoo>