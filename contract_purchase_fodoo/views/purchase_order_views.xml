<odoo>
    <record id="view_purchase_order_form_inherited" model="ir.ui.view">
        <field name="name">purchase.order.form.inherited</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_total']" position="after">
                <field name="extra_amount" string="Monto Extra"/>
                <field name="extended_subtotal" string="Subtotal Extendido"/>
            </xpath>
            <xpath expr="//sheet//group" position="after">
                <group>
                    <field name="is_recurrent" string="Es Recurrente"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
