<odoo>
    <data>
        <!-- Vista Tree (lista) -->
        <record id="view_crypto_wallet_tree" model="ir.ui.view">
            <field name="name">crypto.wallet.tree</field>
            <field name="model">crypto.wallet</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="partner_id"/>
                    <field name="usdt_balance"/>
                </tree>
            </field>
        </record>

        <record id="view_crypto_wallet_tokens_tree" model="ir.ui.view">
            <field name="name">crypto.wallet.tokens.tree</field>
            <field name="model">crypto.wallet.tokens</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="token_id"/>
                    <field name="quantity"/>
                    <field name="buy_price"/>
                    <field name="current_price"/>
                    <field name="total_usdt_value"/>
                    <field name="result"/>
                </tree>
            </field>
        </record>

        <!-- Vista Formulario -->
        <record id="view_crypto_wallet_form" model="ir.ui.view">
            <field name="name">crypto.wallet.form</field>
            <field name="model">crypto.wallet</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="partner_id"/>
                            <field name="usdt_balance"/>
                        </group>
                        <notebook>
                            <page string="Tokens">
                                <field name="tokens"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acciones -->
        <record id="action_crypto_wallet" model="ir.actions.act_window">
            <field name="name">Crypto Wallets</field>
            <field name="res_model">crypto.wallet</field>
            <field name="view_mode">tree,form</field>
        </record>


    </data>

</odoo>
