<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Authors List Template -->
    <template id="authors_list" name="Authors List">
        <t t-set="body_classname" t-value="'o_wslides_body'"/>
        <t t-call="website.layout">
            <div id="wrap" class="wrap o_wslides_wrap">
                <!-- Banner -->
                <div class="oe_structure oe_empty">
                    <section class="s_banner" data-snippet="s_banner"
                            style="background-color: rgb(51, 51, 51); background-image: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <div class="container py-5">
                            <h1 class="display-3 mb-0 text-white">Authors</h1>
                            <p class="lead text-white-50 mt-2">Discover the brilliant minds behind our library collection</p>
                        </div>
                    </section>
                </div>

                <!-- Search and Filter Bar -->
                <div class="container mt-4">
                    <nav class="navbar navbar-expand-md navbar-light shadow-sm rounded mb-3">
                        <div class="container-fluid">
                            <div class="navbar-nav">
                                <a class="nav-link nav-item px-3" href="/libros">
                                    <i class="oi oi-chevron-left"/> Back to Books
                                </a>
                            </div>
                            
                            <!-- Search Box -->
                            <form method="get" action="/autores" class="d-flex ms-auto">
                                <input type="search" 
                                       name="search" 
                                       class="form-control me-2" 
                                       placeholder="Search authors..." 
                                       t-att-value="search_term or ''"/>
                                <button class="btn btn-primary" type="submit">
                                    <i class="fa fa-search"/>
                                </button>
                            </form>

                            <!-- Sort Dropdown -->
                            <div class="dropdown ms-2">
                                <button class="btn btn-outline-secondary dropdown-toggle" 
                                        type="button" 
                                        data-bs-toggle="dropdown">
                                    <i class="fa fa-sort"/> Sort
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" 
                                           t-att-href="'/autores?search=%s&amp;sorting=name' % (search_term or '')">
                                            Name
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" 
                                           t-att-href="'/autores?search=%s&amp;sorting=books' % (search_term or '')">
                                            Book Count
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </nav>

                    <!-- Search Info -->
                    <div t-if="search_term" class="mb-3">
                        <span class="align-items-baseline border d-inline-flex ps-2 rounded">
                            <i class="fa fa-search me-2 text-muted"/>
                            <span t-out="search_term"/>
                            <a href="/autores" class="btn border-0 py-1">&#215;</a>
                        </span>
                        <small class="text-muted ms-2">
                            Found <strong t-out="author_count"/> author(s)
                        </small>
                    </div>
                </div>

                <!-- Authors Grid -->
                <div class="container pb-5">
                    <div t-if="not authors and not search_term">
                        <p class="h2 text-center py-5">No authors found.</p>
                    </div>
                    <div t-elif="search_term and not authors" class="alert alert-info">
                        No author was found matching your search <code t-out="search_term"/>.
                    </div>
                    <t t-else="">
                        <div class="row g-4">
                            <t t-foreach="authors" t-as="author">
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                    <t t-call="website_solt_library.author_card"/>
                                </div>
                            </t>
                        </div>
                    </t>

                    <!-- Pagination -->
                    <div t-if="pager" class="mt-4">
                        <t t-call="portal.pager"/>
                    </div>
                </div>

                <t t-call="website_solt_library.books_footer"/>
            </div>
        </t>
    </template>

    <!-- Author Card Template -->
    <template id="author_card" name="Author Card">
        <div class="card h-100 shadow-sm hover-shadow transition">
            <div class="card-body text-center d-flex flex-column">
                <!-- Author Avatar -->
                <div class="mb-3">
                    <img t-attf-src="/web/image/library.author/#{author.id}/avatar_256"
                         t-att-alt="author.name"
                         class="rounded-circle shadow-sm"
                         style="width: 120px; height: 120px; object-fit: cover;"/>
                </div>

                <!-- Author Name -->
                <h5 class="card-title fw-bold mb-2">
                    <a t-attf-href="/autores/#{author.id}" 
                       class="text-decoration-none text-dark"
                       t-out="author.name"/>
                </h5>

                <!-- Nationality -->
                <p t-if="author.nationality" class="text-muted small mb-2">
                    <i class="fa fa-globe me-1"/> <span t-out="author.nationality"/>
                </p>

                <!-- Book Count Badge -->
                <div class="mt-auto">
                    <span class="badge bg-primary rounded-pill px-3 py-2">
                        <i class="fa fa-book me-1"/> 
                        <span t-out="author.book_count"/> 
                        <span t-if="author.book_count == 1">Book</span>
                        <span t-else="">Books</span>
                    </span>
                </div>

                <!-- View Details Button -->
                <a t-attf-href="/autores/#{author.id}" 
                   class="btn btn-outline-primary btn-sm mt-3">
                    View Profile <i class="fa fa-arrow-right ms-1"/>
                </a>
            </div>
        </div>
    </template>

    <!-- Author Detail Template -->
    <template id="author_detail" name="Author Detail">
        <t t-set="body_classname" t-value="'o_wslides_body'"/>
        <t t-call="website.layout">
            <div id="wrap" class="wrap o_wslides_wrap">
                <!-- Breadcrumb -->
                <div class="container mt-3">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item"><a href="/autores">Authors</a></li>
                            <li class="breadcrumb-item active" aria-current="page" t-out="author.name"/>
                        </ol>
                    </nav>
                </div>

                <!-- Author Profile -->
                <div class="container py-4">
                    <div class="row g-4">
                        <!-- Author Info Column -->
                        <div class="col-12 col-md-4">
                            <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                                <div class="card-body text-center">
                                    <!-- Avatar -->
                                    <img t-attf-src="/web/image/library.author/#{author.id}/avatar_512"
                                         t-att-alt="author.name"
                                         class="rounded-circle shadow mb-3"
                                         style="width: 200px; height: 200px; object-fit: cover;"/>

                                    <!-- Name -->
                                    <h2 class="fw-bold mb-2" t-out="author.name"/>

                                    <!-- Nationality -->
                                    <p t-if="author.nationality" class="text-muted mb-3">
                                        <i class="fa fa-globe me-1"/> <span t-out="author.nationality"/>
                                    </p>

                                    <!-- Dates -->
                                    <div class="mb-3" t-if="author.birth_date or author.death_date">
                                        <small class="text-muted">
                                            <span t-if="author.birth_date" t-out="author.birth_date.year"/>
                                            <span t-if="author.death_date"> - <span t-out="author.death_date.year"/></span>
                                            <span t-if="author.age and not author.death_date"> (Age: <span t-out="author.age"/>)</span>
                                        </small>
                                    </div>

                                    <!-- Stats -->
                                    <div class="border rounded p-3 mb-3">
                                        <div class="row text-center">
                                            <div class="col">
                                                <h4 class="fw-bold mb-0 text-primary" t-out="book_count"/>
                                                <small class="text-muted">Books</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Website Link -->
                                    <a t-if="author.website" 
                                       t-att-href="author.website" 
                                       target="_blank"
                                       class="btn btn-outline-primary w-100">
                                        <i class="fa fa-external-link me-1"/> Visit Website
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Content Column -->
                        <div class="col-12 col-md-8">
                            <!-- Biography -->
                            <div t-if="author.biography" class="card border-0 shadow-sm mb-4">
                                <div class="card-body">
                                    <h4 class="fw-bold border-bottom pb-2 mb-3">
                                        <i class="fa fa-user-circle me-2"/> Biography
                                    </h4>
                                    <div t-field="author.biography" class="text-muted"/>
                                </div>
                            </div>

                            <!-- Books by this Author -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <h4 class="fw-bold border-bottom pb-2 mb-3">
                                        <i class="fa fa-book me-2"/> Books by <span t-out="author.name"/>
                                    </h4>

                                    <div t-if="not books" class="alert alert-info">
                                        This author has no books in our collection yet.
                                    </div>

                                    <div t-else="" class="row g-3">
                                        <t t-foreach="books" t-as="book">
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <div class="card h-100 border">
                                                    <div class="o_book_image_container" style="height: 180px;">
                                                        <img t-attf-src="/web/image/library.book/#{book.id}/image_512"
                                                             t-att-alt="book.name"
                                                             class="o_book_card_image"/>
                                                    </div>
                                                    <div class="card-body p-3">
                                                        <h6 class="card-title fw-bold o_wslides_desc_truncate_2 mb-2">
                                                            <a t-att-href="book.website_url if hasattr(book, 'website_url') else '/libros/%d' % book.id"
                                                               class="text-decoration-none text-dark"
                                                               t-out="book.name"/>
                                                        </h6>
                                                        <small class="text-muted" t-if="book.publication_date">
                                                            <i class="fa fa-calendar me-1"/>
                                                            <span t-out="book.publication_date.year"/>
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Back Button -->
                    <div class="mt-4">
                        <a href="/autores" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                            <i class="oi oi-chevron-left"/> Back to Authors
                        </a>
                    </div>
                </div>

                <t t-call="website_solt_library.books_footer"/>
            </div>
        </t>
    </template>
</odoo>
