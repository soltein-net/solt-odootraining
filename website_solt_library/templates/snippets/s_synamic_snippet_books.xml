<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="s_dynamic_snippet_books" name="Products">
            <t t-call="website.s_dynamic_snippet_template">
                <t t-set="snippet_name" t-value="'s_dynamic_snippet_books'"/>
            </t>
        </template>
        <template id="s_dynamic_snippet_books_options" inherit_id="website.snippet_options">
            <xpath expr="." position="inside">
                <t t-call="website.dynamic_snippet_carousel_options_template">
                    <t t-set="snippet_name" t-value="'dynamic_snippet_books'"/>
                    <t t-set="snippet_selector" t-value="'.s_dynamic_snippet_books'"/>
                </t>
            </xpath>
        </template>
        <template id="s_dynamic_snippet_books_template_options" inherit_id="website.s_dynamic_snippet_options_template">
            <xpath expr="//we-select[@data-name='filter_opt']" position="after">
                <t t-if="snippet_name == 'dynamic_snippet_books'">
                    <we-select string="Category" data-name="book_category_opt" data-attribute-name="bookCategoryId" data-no-preview="true">
                        <we-button data-select-data-attribute="all">All Categories</we-button>
                        <we-button data-select-data-attribute="current">Current Category or All</we-button>
                    </we-select>
                    <we-input string="Book titles" class="o_we_large" data-name="book_titles_opt"
                        data-attribute-name="bookTitles" data-no-preview="true" data-select-data-attribute=""
                        placeholder="e.g. Back to future,Macbeth" title="Comma-separated list of parts of book titles, barcodes or internal reference"/>
                </t>
            </xpath>
        </template>
    </data>
</odoo>