<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View library.loan View List -->
    <record id="view_library_loan_list" model="ir.ui.view">
        <field name="name">view.library.loan.list</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View library.loan form -->
    <record id="view_library_loan_form" model="ir.ui.view">
        <field name="name">view.library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form string="Library Loan">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View library.loan search -->
    <record id="view_library_loan_search" model="ir.ui.view">
        <field name="name">view.library.loan.search</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action library.loan -->
    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Library Loan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Library Loan.
            </p>
        </field>
    </record>

</odoo>
