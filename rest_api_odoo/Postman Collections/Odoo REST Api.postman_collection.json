	"item": [
		{
			"name": "1. Autenticacion",
			"description": "Paso obligatorio. Ejecutar primero para obtener el api-key que se usará en todos los demás requests.",
			"item": [
				{
					"name": "1.1 Obtener API Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData['api-key']) {",
									"    pm.collectionVariables.set('api_key', jsonData['api-key']);",
									"    console.log('API Key guardada en variable de coleccion:', jsonData['api-key']);",
									"    pm.test('Autenticacion exitosa', function () {",
									"        pm.expect(jsonData['Status']).to.eql('auth successful');",
									"    });",
									"} else {",
									"    console.error('Error: no se recibio api-key. Verifica credenciales.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "db",
								"value": "{{db_name}}",
								"type": "text",
								"description": "Nombre de la base de datos Odoo"
							},
							{
								"key": "login",
								"value": "{{odoo_login}}",
								"type": "text",
								"description": "Usuario Odoo"
							},
							{
								"key": "password",
								"value": "{{odoo_password}}",
								"type": "text",
								"description": "Contraseña del usuario"
							}
						],
						"url": {
							"raw": "{{base_url}}/odoo_connect",
							"host": ["{{base_url}}"],
							"path": ["odoo_connect"]
						},
						"description": "Autentica el usuario y retorna un api-key UUID. El script de Test guarda automáticamente el api-key en la variable de colección {{api_key}}."
					},
					"response": []
				}
			]
		},
